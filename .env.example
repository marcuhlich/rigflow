# Copy to .env and fill in. All VITE_* values end up in the browser bundle,
# so only put public/publishable values here – never a service role key.

# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""   # the anon / publishable key

# Optional: Google Sheets export (OAuth client ID, type "Web application")
VITE_GOOGLE_CLIENT_ID=""

# Optional: PostHog analytics (only loaded after the user consents)
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://eu.i.posthog.com"
